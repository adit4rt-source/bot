DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_bot_client_id_here

# Dashboard API
API_PORT=25922
API_KEY=your-secret-api-key-here
ADMIN_IDS=your_discord_id_1,your_discord_id_2

# Pemilik bot (boleh kelola Money & buat Voucher). Koma-pisah untuk banyak owner.
# Jika kosong, fallback ke ADMIN_IDS lalu ID default.
BOT_OWNER_IDS=515920253910253569


# AI Assistant (OpenAI-compatible API, mis. SumoPod)
AI_API_KEY=sk-your-ai-api-key-here
AI_BASE_URL=https://ai.sumopod.com/v1
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=500


# Tenor GIF API key (get from https://console.cloud.google.com → Tenor API)
TENOR_API_KEY=
TENOR_CLIENT_KEY=idcommunity_bot


# Pokemon TCG Card System
# Get free API key from https://pokemontcg.io (optional, increases rate limit to 20k/day)
POKEMON_TCG_API_KEY=
# Set to 1 after running 'node prefetch-cards.js' to disable API calls entirely (100% offline)
POKEMON_TCG_CACHE_ONLY=0
