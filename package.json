{
  "name": "discord-economy-bot",
  "version": "3.4.0",
  "main": "bot.js",
  "scripts": {
    "preinstall": "node -e \"const fs = require('fs'); try { fs.unlinkSync('tsconfig.json'); console.log('Removed corrupt tsconfig.json'); } catch(e) {}\"",
    "start": "node bot.js",
    "test": "node --experimental-sqlite test/run.js"
  },
  "engines": {
    "node": "20.x || 22.x"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.0",
    "better-sqlite3": "^12.10.0",
    "cors": "^2.8.6",
    "discord.js": "^14.26.4",
    "dotenv": "^16.4.5",
    "express": "^4.22.2",
    "qrcode": "^1.5.4"
  },
  "optionalDependencies": {
    "sharp": "^0.33.5"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "sharp": true
  },
  "lavamoat": {
    "allowScripts": {
      "better-sqlite3": true,
      "sharp": true
    }
  }
}
