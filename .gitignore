# Dependencies
node_modules/

# Database (data player - JANGAN di-overwrite saat update!)
economy.sqlite
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# Environment / secrets
.env

# Logs
logs/*.log
*.log
npm-debug.log*

# Backups (keep .gitkeep only)
backups/*.sqlite


# Lockfile is regenerated by `npm install` on the server (Pterodactyl auto-update).
# Tracking it makes `git pull` abort on every restart, so we ignore it.
package-lock.json
